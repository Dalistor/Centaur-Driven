{
  "name": "centaur-volante",
  "displayName": "Centaur Volante",
  "description": "Contexto vivo no editor: funcionalidades, regras, código, testes e autocomplete opcional.",
  "version": "0.2.0",
  "publisher": "dalistor",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:centaurVolante.open",
    "onView:centaurContext"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "centaurVolante.open",
        "title": "Centaur: Abrir fluxos e agentes"
      },
      {
        "command": "centaurVolante.refresh",
        "title": "Centaur: Atualizar contexto"
      },
      {
        "command": "centaurVolante.openSource",
        "title": "Centaur: Abrir fonte vinculada"
      },
      {
        "command": "centaurVolante.tests",
        "title": "Centaur: Abrir testes"
      },
      {
        "command": "centaurVolante.debug",
        "title": "Centaur: Inspecionar execução (depurador)"
      },
      {
        "command": "centaurVolante.diff",
        "title": "Centaur: Revisar alterações"
      },
      {
        "command": "centaurVolante.enableCompletion",
        "title": "Centaur: Habilitar autocomplete IA nesta sessão"
      },
      {
        "command": "centaurVolante.disableCompletion",
        "title": "Centaur: Desabilitar autocomplete IA"
      }
    ],
    "configuration": {
      "title": "Centaur Volante",
      "properties": {
        "centaurVolante.python": {
          "type": "string",
          "default": "python3",
          "description": "Executável Python 3 para gerar o snapshot local."
        },
        "centaurVolante.agentProfiles": {
          "type": "array",
          "default": [],
          "description": "Executores locais configurados por você. Use argumentos separados, sem shell. Marcadores: {prompt}, {workspace}, {contract}, {rule}.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificador único"
              },
              "label": {
                "type": "string",
                "description": "Nome mostrado no painel"
              },
              "command": {
                "type": "string",
                "description": "Executável local (ex.: codex)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Argumentos para o processo (ex.: [\"exec\", \"{prompt}\"])"
              }
            }
          }
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "centaurContext",
          "name": "Centaur · Funcionalidades"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "centaurVolante.refresh",
          "when": "view == centaurContext",
          "group": "navigation"
        },
        {
          "command": "centaurVolante.tests",
          "when": "view == centaurContext",
          "group": "context"
        },
        {
          "command": "centaurVolante.debug",
          "when": "view == centaurContext",
          "group": "context"
        },
        {
          "command": "centaurVolante.diff",
          "when": "view == centaurContext",
          "group": "context"
        },
        {
          "command": "centaurVolante.open",
          "when": "view == centaurContext",
          "group": "context"
        },
        {
          "command": "centaurVolante.enableCompletion",
          "when": "view == centaurContext",
          "group": "context"
        },
        {
          "command": "centaurVolante.disableCompletion",
          "when": "view == centaurContext",
          "group": "context"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "package": "npm run build && vsce package --no-dependencies --out ../.centaur/build/centaur-volante.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "files": [
    "extension.js",
    "flow-store.js",
    "agent-runner.js",
    "dist/**",
    "README.md",
    "context-tree.js",
    "editor-context.js",
    "completion.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dalistor/Centaur-Driven.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Centaur executa Python local para ler os contratos."
    }
  }
}
